# ------------------------------------------------------------------
#  TP Messaging — .gitignore
# ------------------------------------------------------------------

# No Java here (it lives in the TP1 repo) and the broker data lives on the
# named volume `rabbit-data`: only local scratch is ignored.
*.db
*.sqlite

# --- Secrets and local env (the Gemini key lives in the shell only) ---
.env
.env.*
*.env
*.local

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
.factorypath

# --- Logs and ad-hoc shell-redirect output (e.g. `... 2> err.txt`) ---
*.log
/err*.txt
/out*.txt

# --- OS ---
.DS_Store
Thumbs.db
